---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SCHEMES, type Scheme } from '../../lib/schemes';
import { organizationSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return SCHEMES.map((s) => ({ params: { id: s.id }, props: { scheme: s } }));
}

const { scheme } = Astro.props as { scheme: Scheme };
const site = Astro.site ?? new URL('https://ridnavyshyvka.com.ua');
const url = new URL(`/shemy/${scheme.id}/`, site).href;

const crumbs = [
  { name: 'Головна', href: '/' },
  { name: 'Схеми для вишивки', href: '/shemy/' },
  { name: scheme.title, href: `/shemy/${scheme.id}/` },
];
const jsonld = [
  organizationSchema(site.href),
  breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))),
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `Схема для вишивки хрестиком «${scheme.title}»`,
    description: `${scheme.subtitle}. ${scheme.width} × ${scheme.height} хрестиків, ${scheme.colors.length} кольори, ${scheme.stitches} стібків.`,
    url,
    inLanguage: 'uk',
    isAccessibleForFree: true,
    learningResourceType: 'Схема для вишивки хрестиком',
    educationalLevel: scheme.level,
    timeRequired: scheme.hours,
    encodingFormat: 'application/pdf',
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: new URL(scheme.pdf, site).href,
      encodingFormat: 'application/pdf',
    },
    image: new URL(scheme.preview, site).href,
    isPartOf: { '@type': 'CollectionPage', url: new URL('/shemy/', site).href },
    publisher: { '@id': `${site.href}#organization` },
  },
];
---

<BaseLayout
  title={`Схема «${scheme.title}» — безкоштовно, PDF`}
  description={`${scheme.subtitle}. Схема ${scheme.width} × ${scheme.height} хрестиків, ${scheme.colors.length} кольори DMC, рівень «${scheme.level}». Дивіться онлайн або завантажте PDF для друку.`}
  canonicalPath={`/shemy/${scheme.id}/`}
  ogType="article"
  image={scheme.preview}
  jsonld={jsonld}
>
  <Breadcrumbs items={crumbs} />
  <article class="prose-uk">
    <h1
      class="stitched mb-2 font-display text-3xl font-extrabold leading-tight text-[var(--color-ink)] md:text-4xl"
    >
      {scheme.title}
    </h1>
    <p class="lead">{scheme.subtitle}</p>

    <div class="not-prose my-6 rounded-xl border border-[var(--color-line)] bg-white p-5">
      <dl class="grid gap-3 sm:grid-cols-4">
        <div class="rounded-lg bg-[var(--color-paper-2)] p-3">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">Розмір</dt>
          <dd
            class="mt-1 font-display text-xl font-bold text-[var(--color-brand)]"
            style="font-variant-numeric:tabular-nums"
          >
            {scheme.width} × {scheme.height}
          </dd>
        </div>
        <div class="rounded-lg bg-[var(--color-paper-2)] p-3">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">Стібків</dt>
          <dd
            class="mt-1 font-display text-xl font-bold text-[var(--color-ink)]"
            style="font-variant-numeric:tabular-nums"
          >
            {scheme.stitches}
          </dd>
        </div>
        <div class="rounded-lg bg-[var(--color-paper-2)] p-3">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">Рівень</dt>
          <dd class="mt-1 font-display text-xl font-bold text-[var(--color-ink)]">{scheme.level}</dd>
        </div>
        <div class="rounded-lg bg-[var(--color-paper-2)] p-3">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">Часу</dt>
          <dd class="mt-1 font-display text-xl font-bold text-[var(--color-ink)]">{scheme.hours}</dd>
        </div>
      </dl>

      <a
        href={scheme.pdf}
        download
        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand)] px-5 py-3 text-base font-semibold transition hover:opacity-90"
        style="color:#fff;text-decoration:none"
      >
        Завантажити PDF для друку
      </a>
      <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
        Безкоштовно, без реєстрації. Кольоровий аркуш, робочий чорно-білий і лінійка для
        перевірки масштабу друку.
      </p>
    </div>

    <h2>Схема</h2>
    <div class="not-prose my-5 overflow-x-auto rounded-xl border border-[var(--color-line)] bg-white p-3">
      <div class="scheme-chart" set:html={scheme.chart} />
    </div>
    <p class="text-sm text-[var(--color-ink-soft)]">
      Червоні стрілки по краях позначають центр — з нього починають вишивати. Лінії сітки:
      тонка — клітинка, середня — кожні 5, товста — кожні 10. Якщо бачите схему вперше,
      почніть із гіда <a href="/vyshyvka-hrestykom/yak-chytaty-shemy-hrestykom/">як читати схеми хрестиком</a>.
    </p>

    <h2>Нитки</h2>
    <div class="not-prose overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-[var(--color-paper-2)] text-left text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Символ</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Колір</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Нитка</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Назва</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2 text-right">Стібків</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2 text-right">Нитки</th>
          </tr>
        </thead>
        <tbody>
          {
            scheme.colors.map((c) => (
              <tr>
                <td class="border-b border-[var(--color-line)] px-3 py-2" set:html={c.symbol} />
                <td class="border-b border-[var(--color-line)] px-3 py-2">
                  <span
                    class="inline-block h-4 w-8 rounded border border-[var(--color-ink-soft)] align-middle"
                    style={`background:${c.hex}`}
                  />
                </td>
                <td class="border-b border-[var(--color-line)] px-3 py-2 font-semibold">
                  DMC {c.dmc}
                </td>
                <td class="border-b border-[var(--color-line)] px-3 py-2">{c.name}</td>
                <td
                  class="border-b border-[var(--color-line)] px-3 py-2 text-right"
                  style="font-variant-numeric:tabular-nums"
                >
                  {c.stitches}
                </td>
                <td
                  class="border-b border-[var(--color-line)] px-3 py-2 text-right"
                  style="font-variant-numeric:tabular-nums"
                >
                  ≈{c.meters} м
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2>Розмір готової роботи</h2>
    <div class="not-prose overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-[var(--color-paper-2)] text-left text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Канва</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Щільність</th>
            <th class="border-b border-[var(--color-ink-soft)] px-3 py-2">Розмір роботи</th>
          </tr>
        </thead>
        <tbody>
          {
            scheme.sizes.map((s) => (
              <tr>
                <td class="border-b border-[var(--color-line)] px-3 py-2">Аїда {s.count}</td>
                <td class="border-b border-[var(--color-line)] px-3 py-2">{s.density}</td>
                <td class="border-b border-[var(--color-line)] px-3 py-2 font-semibold">{s.cm}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="text-sm text-[var(--color-ink-soft)]">
      Тканину ріжте не менше ніж 20 × 20 см — для будь-якої з цих канв. Цей запас потрібен не
      мотиву, а пʼяльцям і рамці: менший клапоть просто нема за що натягнути. Інший розмір
      порахує <a href="/kalkulyator-rozmiru-vyshyvky/">калькулятор розміру вишивки</a>.
    </p>

    <h2>Що потрібно</h2>
    <p>
      Нитка: {scheme.strands}. Голка: {scheme.needle}. Одного мотка кожного кольору вистачить
      із великим запасом. Детальніше про вибір: <a href="/materialy-dlya-vyshyvky/kanva-dlya-vyshyvky/">канва</a>{', '}<a
        href="/materialy-dlya-vyshyvky/nytky-muline-dlya-vyshyvky/">нитки муліне</a>{', '}<a
        href="/materialy-dlya-vyshyvky/golky-dlya-vyshyvannya/">голки</a>.
    </p>

    <h2>Про мотив</h2>
    <p>{scheme.meaning}</p>
    <p>{scheme.dating}</p>

    <h2>Перед початком</h2>
    <p>
      Обметайте край тканини або прошийте зигзагом, щоб не сипався. Складіть полотно вчетверо
      й наметайте центр контрастною ниткою — його ж показують червоні стрілки на схемі.
      Верхній стібок усіх хрестиків має лежати в один бік, інакше робота «рябить». Вузлів на
      вивороті не роблять: кінець нитки ховають під стібками.
    </p>
    <p>
      Якщо вишиваєте вперше, подивіться
      <a href="/vyshyvka-hrestykom/vyshyvka-hrestykom-dlya-pochatkivciv/">вишивку хрестиком для початківців</a>.
    </p>
  </article>
</BaseLayout>

<style>
  /* SVG схеми має viewBox, тож тягнеться по ширині колонки. На вузькому екрані
     обгортка з overflow-x лишає можливість роздивитися клітинки, не стискаючи
     їх у кашу. */
  .scheme-chart :global(svg) {
    display: block;
    width: 100%;
    min-width: 320px;
    height: auto;
  }
</style>
