---
/**
 * Блок безкоштовних схем на сторінці.
 * Гібридна роздача: окремі PDF — одразу, повний бандл — у Telegram-каналі.
 */
import { PATTERNS, BUNDLES, TELEGRAM, patternUrl, bundleLink, isOutline } from '../lib/patterns';

interface Props {
  /** Ключі схем із PATTERNS — качаються прямо звідси */
  patterns?: string[];
  /** Ключ бандла з BUNDLES — CTA на Telegram */
  bundle?: string;
  title?: string;
}
const { patterns = [], bundle, title = 'Безкоштовні схеми — завантажити' } = Astro.props;

const items = patterns.map((k) => PATTERNS[k]).filter(Boolean);
const b = bundle ? BUNDLES[bundle] : undefined;
if (import.meta.env.DEV) {
  const missing = patterns.filter((k) => !PATTERNS[k]);
  if (missing.length) console.warn(`[FreePattern] невідомі схеми: ${missing.join(', ')}`);
  if (bundle && !b) console.warn(`[FreePattern] невідомий бандл: ${bundle}`);
}
---
{
  (items.length > 0 || b) && (
    <aside class="toc my-8 rounded-xl border border-[var(--color-brand)]/25 bg-[var(--color-paper-2)] p-5">
      <h2 class="mt-0 mb-1 font-display text-lg font-bold text-[var(--color-brand-dark)]">{title}</h2>
      <p class="mt-0 mb-4 text-sm text-[var(--color-ink-soft)]">
        PDF готовий до друку: сітка, легенда ниток і покрокова інструкція. Безкоштовно, без реєстрації.
      </p>

      {items.length > 0 && (
        <ul class="my-0 grid list-none gap-2 p-0 sm:grid-cols-2">
          {items.map((p) => (
            <li class="m-0 p-0">
              <a
                href={patternUrl(p)}
                download
                class="flex h-full items-center gap-3 rounded-lg border border-[var(--color-line)] bg-white p-3 no-underline transition-colors hover:border-[var(--color-brand)]"
              >
                <span
                  class="shrink-0 rounded bg-[var(--color-brand)]/10 px-2 py-1 text-xs font-bold text-[var(--color-brand)]"
                  aria-hidden="true"
                >
                  PDF
                </span>
                <span class="min-w-0">
                  <span class="block font-medium text-[var(--color-ink)]">{p.name}</span>
                  <span class="block text-xs text-[var(--color-ink-soft)]">
                    {p.w}×{p.h}{isOutline(p) ? ' мм' : ''}
                    {p.hours ? ` · ${p.hours}` : ''}
                    {p.difficulty ? ` · ${p.difficulty}` : ''}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {b && TELEGRAM.enabled && (
        <p class="mt-4 mb-0 rounded-lg border border-dashed border-[var(--color-brand)]/40 bg-white p-3 text-sm">
          <strong class="text-[var(--color-ink)]">Повний набір «{b.name}»</strong> — {b.patterns.length} схем
          одним архівом. {b.desc}{' '}
          <a
            href={bundleLink(bundle!)}
            target="_blank"
            rel="noopener"
            class="font-semibold text-[var(--color-brand)] hover:underline"
          >
            Забрати всі {b.patterns.length} схем у Telegram →
          </a>
        </p>
      )}
    </aside>
  )
}
