---
// AdSense: код для підтвердження власності сайту й показу оголошень.
// ID — у src/lib/adsense.ts; порожній = скрипт не підключається.
import { PUB_ID, adsenseEnabled } from '../lib/adsense';
---

{adsenseEnabled && (
  <script
    is:inline
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB_ID}`}
    crossorigin="anonymous"
  />
)}
